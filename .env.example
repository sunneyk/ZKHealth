# ── AI ─────────────────────────────────────────────────────────────────────
# Optional but recommended: enables the Anthropic SDK with prompt caching,
# which is faster than the local CLI fallback.
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ── Solana ─────────────────────────────────────────────────────────────────
# Optional: path to your devnet keypair for on-chain proof anchoring.
# Default: ~/.config/solana/id.json
# SOLANA_KEYPAIR_PATH=/path/to/keypair.json

# ── Wearables ──────────────────────────────────────────────────────────────
# Each provider requires creating a developer app and registering the
# matching callback URL. Only configure the providers you actually use.

# Fitbit — https://dev.fitbit.com/apps/new
#   OAuth 2.0 Application Type: Personal
#   Callback URL: http://localhost:8000/api/wearable/fitbit/callback
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# FITBIT_REDIRECT_URI=http://localhost:8000/api/wearable/fitbit/callback

# WHOOP — https://developer.whoop.com
#   Required scope: read:recovery read:cycles read:sleep read:profile offline
#   Callback URL: http://localhost:8000/api/wearable/whoop/callback
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=http://localhost:8000/api/wearable/whoop/callback

# Oura — https://cloud.ouraring.com/oauth/applications
#   Callback URL: http://localhost:8000/api/wearable/oura/callback
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# OURA_REDIRECT_URI=http://localhost:8000/api/wearable/oura/callback
